# THE-BRIDGE v1.0.0 — Environment Configuration
# Copy to .env and fill in your values
#
# For Docker deployment, copy .env.docker to .env instead:
#   cp .env.docker .env && docker compose up -d

# Node identity
THE_BRIDGE_NODE_ID=engine-1

# DAG Consensus peers (comma-separated host:port)
THE_BRIDGE_PEERS=

# WAL replication targets (comma-separated host:port)
THE_BRIDGE_REPLICAS=

# Storage paths
THE_BRIDGE_WAL_DIR=/var/lib/the-bridge/wal
THE_BRIDGE_HOOKS_DIR=/etc/the-bridge/hooks

# TLS/SSL (optional — engine works without it, but production requires it)
THE_BRIDGE_TLS_CERT=/etc/the-bridge/tls/cert.pem
THE_BRIDGE_TLS_KEY=/etc/the-bridge/tls/key.pem

# WAL Encryption at-rest (AES-256-GCM)
# REQUIRED in production. 32 bytes encoded as base64.
# Generate: openssl rand -base64 32
WAL_ENCRYPTION_KEY=

# WAL Immutable Signing (Ed25519)
# Optional — defaults to derivation from node_id if empty.
# Set a fixed seed for determinism across restarts.
WAL_SIGNING_SEED=

# FIX over TLS
# Optional — without these, FIX TLS acceptor (port 4443) will not start.
FIX_TLS_CERT=/etc/the-bridge/tls/cert.pem
FIX_TLS_KEY=/etc/the-bridge/tls/key.pem

# PostgreSQL (optional — engine works without it, WAL is always primary store)
# Database URL for persisting orders, trades, and WAL entries
DATABASE_URL=postgresql://user:password@localhost:5432/the_bridge

# Logging
RUST_LOG=the_bridge=info
RUST_BACKTRACE=1

# Billing (Stripe/Paddle — for subscription management)
STRIPE_SECRET_KEY=
PADDLE_API_KEY=

# Default admin API key (generated on first start if empty)
ADMIN_API_KEY=
