[Unit]
Description=THE-BRIDGE Matching Engine — 1.5M TPS Institutional Exchange
Documentation=https://the-bridge.io/docs
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=the-bridge
Group=the-bridge
ExecStart=/usr/local/bin/the-bridge-matching-engine
WorkingDirectory=/var/lib/the-bridge
Restart=always
RestartSec=5
LimitNOFILE=1048576
LimitNPROC=infinity
LimitMEMLOCK=infinity
CapabilityBoundingSet=CAP_IPC_LOCK CAP_NET_BIND_SERVICE CAP_SYS_NICE
AmbientCapabilities=CAP_IPC_LOCK CAP_NET_BIND_SERVICE CAP_SYS_NICE
CPUAccounting=yes
MemoryAccounting=yes
IOAccounting=yes

Environment=THE_BRIDGE_NODE_ID=%H
Environment=THE_BRIDGE_WAL_DIR=/var/lib/the-bridge/wal
Environment=THE_BRIDGE_ISO20022_DIR=/var/lib/the-bridge/iso20022
Environment=RUST_LOG=the_bridge=info
Environment=RUST_BACKTRACE=1

ExecReload=/bin/kill -HUP $MAINPID
ExecStop=/bin/kill -TERM $MAINPID

[Install]
WantedBy=multi-user.target
