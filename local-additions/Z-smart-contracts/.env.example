# ============================================================
# SwiftBridge Smart Contract Deployment Configuration
# انسخ هذا الملف إلى .env واملأ القيم
# ============================================================

# Ethereum RPC URL (Sepolia testnet recommended for first deploy)
ETH_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY

# Deployer wallet private key (with 0x prefix — needs test ETH)
DEPLOYER_PRIVATE_KEY=0x...

# TEE Enclave address (ed25519 public key hash on-chain)
TEE_ENCLAVE_ADDRESS=0x...

# Optional: Etherscan API key for contract verification
ETHERSCAN_API_KEY=

# Deployment network (sepolia | holesky | ethereum)
DEPLOY_NETWORK=sepolia

# Gas configuration
GAS_PRICE_GWEI=10
GAS_LIMIT=5000000
